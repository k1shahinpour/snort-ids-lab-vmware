# Snort 3 Custom Rules — snort-ids-lab-vmware
# Defender IP: 192.168.224.128 (Ubuntu 26.04)
# Attacker IP:  192.168.224.129 (Kali Linux 2026.1)
#
# ─── ICMP ────────────────────────────────────────────────────────────────────

alert icmp any any -> 192.168.224.128 any (msg:"ICMP Ping Detected"; sid:1000001; rev:1;)

# ─── TCP SCANNING ─────────────────────────────────────────────────────────────

# Detects SYN port scan: 5+ SYN packets from same source in 3 seconds
alert tcp any any -> 192.168.224.128 any (msg:"TCP Port Scan Detected"; flags:S; detection_filter:track by_src, count 5, seconds 3; sid:1000002; rev:1;)

# ─── DoS / FLOOD ──────────────────────────────────────────────────────────────

# Detects SYN flood: 100+ SYN packets to same destination in 1 second
alert tcp any any -> 192.168.224.128 any (msg:"SYN Flood DoS Detected"; flags:S; detection_filter:track by_dst, count 100, seconds 1; sid:1000003; rev:1;)

# ─── OS FINGERPRINTING ────────────────────────────────────────────────────────

# Detects nmap -O OS fingerprinting: all 16 nmap OS probes target port 1 (tcpmux)
# Normal traffic never targets port 1 — reliable low-false-positive signature
# Verified via tcpdump: FPU (FIN+PUSH+URG) packets confirmed arriving at VM
alert tcp any any -> 192.168.224.128 1 (msg:"OS Fingerprinting - Nmap Probe to tcpmux Detected"; sid:1000004; rev:3;)
